{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "rootDir": ".",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "outDir": "./build",
        "noEmit": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "isolatedModules": true,
    }
}